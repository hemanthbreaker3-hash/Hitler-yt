#!/usr/bin/env bash
# Robust AniMoviesZoneflix VPS deployment. Run from the repository root.
set -Eeuo pipefail
IFS=$'\n\t'

APP_NAME="AniMoviesZoneflix"
GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'
info(){ printf "${GREEN}[%s]${NC} %s\n" "$APP_NAME" "$*"; }
warn(){ printf "${YELLOW}[WARN]${NC} %s\n" "$*"; }
die(){ printf "${RED}[ERROR]${NC} %s\n" "$*" >&2; exit 1; }
run_root(){ if [ "$(id -u)" -eq 0 ]; then "$@"; elif command -v sudo >/dev/null 2>&1; then sudo "$@"; else die "Root privileges are required. Run as root or install sudo."; fi; }

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"
[[ -f docker-compose.yml && -f Dockerfile && -f requirements.txt ]] || die "Run from the AniMoviesZoneflix project root; docker-compose.yml, Dockerfile and requirements.txt must exist."
command -v python3 >/dev/null 2>&1 || die "Python 3 is required to validate and write the environment file."

# Host prerequisites.
if ! command -v curl >/dev/null 2>&1; then
  if command -v apt-get >/dev/null 2>&1; then
    run_root apt-get update -qq
    run_root apt-get install -y -qq curl ca-certificates
  elif command -v dnf >/dev/null 2>&1; then
    run_root dnf install -y curl ca-certificates
  else
    die "curl is missing. Install curl and ca-certificates, then rerun."
  fi
fi

if ! command -v docker >/dev/null 2>&1; then
  info "Installing Docker Engine and Compose plugin..."
  curl -fsSL https://get.docker.com -o /tmp/animovieszoneflix-get-docker.sh || die "Could not download Docker installer. Check VPS DNS/network access."
  run_root sh /tmp/animovieszoneflix-get-docker.sh
  rm -f /tmp/animovieszoneflix-get-docker.sh
fi
run_root systemctl enable --now docker || die "Docker service could not be started. Check: sudo systemctl status docker --no-pager"

# Prefer unprivileged Docker; use sudo for the whole Docker/Compose invocation
# when this SSH session has not refreshed docker-group membership.
DOCKER=(docker)
if ! docker info >/dev/null 2>&1; then
  if command -v sudo >/dev/null 2>&1 && sudo docker info >/dev/null 2>&1; then
    DOCKER=(sudo docker)
    warn "Using sudo for Docker because this login session lacks Docker socket permission."
  else
    die "Docker daemon is not accessible. Check 'sudo systemctl status docker' and 'sudo docker info'. Do not chmod 666 the Docker socket."
  fi
fi

if "${DOCKER[@]}" compose version >/dev/null 2>&1; then
  COMPOSE=("${DOCKER[@]}" compose)
elif command -v docker-compose >/dev/null 2>&1; then
  if [[ "${DOCKER[0]}" == sudo ]]; then COMPOSE=(sudo docker-compose); else COMPOSE=(docker-compose); fi
else
  warn "Docker Compose plugin missing; attempting package installation..."
  if command -v apt-get >/dev/null 2>&1; then
    run_root apt-get update -qq
    run_root apt-get install -y docker-compose-plugin
  elif command -v dnf >/dev/null 2>&1; then
    run_root dnf install -y docker-compose-plugin
  fi
  if "${DOCKER[@]}" compose version >/dev/null 2>&1; then COMPOSE=("${DOCKER[@]}" compose); else die "Docker Compose is unavailable. Install the Docker Compose plugin and rerun."; fi
fi

# Build .env without sourcing/evaluating user-controlled shell text.
# Pass the ngrok token with: export NGROK_AUTHTOKEN=YOUR_NGROK_AUTH_TOKEN

# Interactive DuckDNS prompt (if TTY and not already set in env/.env)
if [ -t 0 ] && [ -z "${DUCKDNS_DOMAIN:-}" ] && ! grep -Eq '^DUCKDNS_DOMAIN=.+' .env 2>/dev/null; then
  printf "${GREEN}[%s]${NC} DuckDNS subdomain or URL (e.g. hitler-yt or hitler-yt.duckdns.org, Enter to skip): " "$APP_NAME"
  read -r INPUT_DUCK_DOM || true
  if [ -n "${INPUT_DUCK_DOM:-}" ]; then
    export DUCKDNS_DOMAIN="$INPUT_DUCK_DOM"
    printf "${GREEN}[%s]${NC} DuckDNS token (Enter to skip): " "$APP_NAME"
    read -r INPUT_DUCK_TOK || true
    [ -n "${INPUT_DUCK_TOK:-}" ] && export DUCKDNS_TOKEN="$INPUT_DUCK_TOK"
  fi
fi

if [[ ! -f .env ]]; then
  [[ -f .env.example ]] || die ".env.example is missing."
  cp .env.example .env
fi
python3 - <<'PY'
import json, os, pathlib, re, secrets
p = pathlib.Path('.env')

def read_env(path):
    if not path.exists(): return {}
    result = {}
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith('#'): continue
        if line.startswith('export '): line = line[7:].lstrip()
        if '=' not in line: continue
        key, value = line.split('=', 1)
        key, value = key.strip(), value.strip()
        if not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', key): continue
        if len(value) >= 2 and value[0] == value[-1] and value[0] in ('"', "'"):
            if value[0] == '"':
                try: value = json.loads(value)
                except Exception: value = value[1:-1]
            else: value = value[1:-1]
        result[key] = value
    return result

values = read_env(p)
values.update(read_env(pathlib.Path('config.env')))
# Canonical environment variables win; support aliases used in older deploy commands.
aliases = {'APP_ID':'API_ID', 'DATABASE_URI':'MONGODB_URI', 'DATABASE_URL':'MONGODB_URI', 'LOG_CHANNEL':'CHANNEL_ID'}
for alias, canonical in aliases.items():
    if os.environ.get(alias) and not os.environ.get(canonical):
        os.environ[canonical] = os.environ[alias]
keys = ('API_ID','API_HASH','BOT_TOKEN','OWNER_ID','ADMINS','CHANNEL_ID','FORCE_SUB_CHANNELS','MONGODB_URI','DATABASE_NAME','REDIS_URL','BASE_URL','BACKEND_URL','WEBSITE_URL','PORT','DEBUG','DEFAULT_EXPIRY','SESSIONS','ADMIN_PANEL_TOKEN','TMDB_API_KEY','BRANDING','LOGO_URL','STREAM_CHUNK_SIZE','NGROK_AUTHTOKEN','TUNNEL_PROVIDER','CLOUDFLARE_URL','NGROK_URL','DUCKDNS_DOMAIN','DUCKDNS_TOKEN')
for key in keys:
    if key in os.environ: values[key] = os.environ[key]
# Also accept legacy alias values from .env/config.env.
for alias, canonical in aliases.items():
    if values.get(alias) and not values.get(canonical): values[canonical] = values[alias]
# Generate a strong dashboard password if unset or still a placeholder.
if not values.get('ADMIN_PANEL_TOKEN') or values['ADMIN_PANEL_TOKEN'].lower().startswith(('replace-', 'change_me', 'your_')):
    values['ADMIN_PANEL_TOKEN'] = secrets.token_urlsafe(36)
# Keep all existing extra keys, safely quoted for pydantic/dotenv.
lines = ['# Generated by deploy.vps; contains secrets. Do not commit or share.']
for key in sorted(values): lines.append(f'{key}={json.dumps(str(values[key]))}')
p.write_text('\n'.join(lines) + '\n')
os.chmod(p, 0o600)
PY

# Strict preflight: fail before building if a required setting is absent/placeholder.
python3 - <<'PY'
import json, pathlib, re, sys
v = {}
for line in pathlib.Path('.env').read_text().splitlines():
    if not line or line.lstrip().startswith('#') or '=' not in line: continue
    k, raw = line.split('=', 1); raw = raw.strip()
    try: value = json.loads(raw) if raw.startswith('"') else raw
    except Exception: value = raw.strip('"')
    v[k.strip()] = str(value)
required = ('API_ID','API_HASH','BOT_TOKEN','OWNER_ID','MONGODB_URI')
for k in required:
    value = v.get(k, '').strip()
    if not value or value.lower().startswith(('your_', 'change_me', 'replace_')):
        sys.exit(f'[ERROR] {k} is missing or still a placeholder. Export it before deployment or edit config.env.')
for k in ('API_ID','OWNER_ID'):
    if not re.fullmatch(r'-?\d+', v[k].strip()): sys.exit(f'[ERROR] {k} must be numeric.')
for k in ('ADMINS','FORCE_SUB_CHANNELS'):
    raw = v.get(k, '').strip()
    if raw and not all(re.fullmatch(r'-?\d+', x.strip()) for x in raw.split(',')):
        sys.exit(f'[ERROR] {k} must be comma-separated numeric Telegram IDs.')
if v.get('CHANNEL_ID','').strip() and not re.fullmatch(r'-?\d+', v['CHANNEL_ID'].strip()):
    sys.exit('[ERROR] CHANNEL_ID must be numeric.')
if not v['MONGODB_URI'].startswith(('mongodb://','mongodb+srv://')) or v['MONGODB_URI'] == 'mongodb://mongodb:27017':
    sys.exit('[ERROR] Set a reachable MONGODB_URI (for example your MongoDB Atlas URI); the bundled local MongoDB service is not enabled in this deployment.')
if len(v.get('ADMIN_PANEL_TOKEN','').strip()) < 24:
    sys.exit('[ERROR] ADMIN_PANEL_TOKEN must contain at least 24 characters.')
if v.get('BASE_URL','').startswith(('http://localhost','http://127.0.0.1')):
    print('[WARN] BASE_URL is localhost. Bot links will not work publicly until you set BASE_URL to your public HTTPS URL.')
PY

info "Validating Docker Compose configuration..."
"${COMPOSE[@]}" config --quiet || die "Compose configuration is invalid. Check .env and docker-compose.yml."
info "Building and starting AniMoviesZoneflix..."
"${COMPOSE[@]}" up -d --build --remove-orphans

PORT_VALUE="$(python3 - <<'PY'
import json, pathlib
for line in pathlib.Path('.env').read_text().splitlines():
    if line.startswith('PORT='):
        raw=line.split('=',1)[1].strip()
        try: print(json.loads(raw))
        except Exception: print(raw.strip('"'))
        break
else: print('8000')
PY
)"
PORT_VALUE="${PORT_VALUE:-8000}"
info "Waiting up to 180 seconds for http://127.0.0.1:${PORT_VALUE}/health ..."
for _ in $(seq 1 90); do
  if curl -fsS "http://127.0.0.1:${PORT_VALUE}/health" >/dev/null 2>&1; then
    info "Web health check passed."
    info "Admin dashboard: /panel (username: admin; password stored in .env as ADMIN_PANEL_TOKEN)."
    "${COMPOSE[@]}" ps

    # Public tunnel is started inside the web container based on TUNNEL_PROVIDER.
    #   export TUNNEL_PROVIDER=cloudflare  → Cloudflare quick tunnel (*.trycloudflare.com), synced to MongoDB
    #   export TUNNEL_PROVIDER=ngrok        → pyngrok (needs NGROK_AUTHTOKEN)
    run_root systemctl disable --now file2link-cloudflared.service animovieszoneflix-ngrok.service >/dev/null 2>&1 || true
    PROVIDER="$(python3 - <<'PY2'
import json, pathlib
v={}
for line in pathlib.Path('.env').read_text().splitlines():
    if not line or line.lstrip().startswith('#') or '=' not in line: continue
    k, raw = line.split('=',1); raw=raw.strip()
    try: val=json.loads(raw) if raw.startswith('"') else raw
    except Exception: val=raw.strip('"')
    v[k.strip()]=str(val)
print((v.get('TUNNEL_PROVIDER') or 'cloudflare').strip().lower())
PY2
)"
    info "TUNNEL_PROVIDER=${PROVIDER}"
    if [ "$PROVIDER" = "ngrok" ]; then
      if grep -Eq '^NGROK_AUTHTOKEN=.+' .env && ! grep -Eq '^NGROK_AUTHTOKEN=("|\"")?\s*$' .env; then
        info "ngrok selected. App will create an HTTPS ngrok URL on startup and sync it to MongoDB."
      else
        warn "TUNNEL_PROVIDER=ngrok but NGROK_AUTHTOKEN is empty. Add token or switch: export TUNNEL_PROVIDER=cloudflare"
      fi
    else
      info "Cloudflare quick tunnel selected. App will generate https://*.trycloudflare.com and sync backend/stream URLs."
      info "No Cloudflare account token is required for quick tunnels."
    fi

    # Auto-configure DuckDNS + Caddy HTTPS reverse proxy (reads .env first, falls back to MongoDB settings)
    DUCK_INFO="$(python3 - <<'PY_DUCK'
import json, pathlib
v={}
for line in pathlib.Path('.env').read_text().splitlines():
    if not line or line.lstrip().startswith('#') or '=' not in line: continue
    k, raw = line.split('=',1); raw=raw.strip()
    try: val=json.loads(raw) if raw.startswith('"') else raw
    except Exception: val=raw.strip('"')
    v[k.strip()]=str(val)
dom = (v.get('DUCKDNS_DOMAIN') or '').strip().lower()
if dom.startswith(('http://','https://')):
    from urllib.parse import urlparse
    dom = (urlparse(dom).hostname or '').lower()
dom = dom.strip('.')
if dom.endswith('.duckdns.org'):
    dom = dom[:-len('.duckdns.org')]
tok = (v.get('DUCKDNS_TOKEN') or '').strip()
print(f"{dom}|{tok}")
PY_DUCK
)"
    DUCK_DOM="${DUCK_INFO%%|*}"
    DUCK_TOK="${DUCK_INFO#*|}"
    if [ -z "$DUCK_DOM" ] || [ -z "$DUCK_TOK" ]; then
      MONGO_DUCK="$("${COMPOSE[@]}" exec -T web python3 -c "import asyncio; from app.utils.duckdns import get_duckdns_config; d,t=asyncio.run(get_duckdns_config()); print(f'{d}|{t}')" 2>/dev/null | tail -n 1 || true)"
      if [[ "$MONGO_DUCK" == *"|"* ]]; then
        DUCK_DOM="${MONGO_DUCK%%|*}"
        DUCK_TOK="${MONGO_DUCK#*|}"
      fi
    fi
    if [ -n "$DUCK_DOM" ] && [ -n "$DUCK_TOK" ]; then
      info "Configuring DuckDNS (${DUCK_DOM}.duckdns.org) + Caddy HTTPS -> 127.0.0.1:${PORT_VALUE}..."
      PUBLIC_IP="$(curl -fsS --max-time 6 https://api.ipify.org 2>/dev/null || curl -fsS --max-time 6 https://ifconfig.me/ip 2>/dev/null || true)"
      curl -fsS --max-time 10 "https://www.duckdns.org/update?domains=${DUCK_DOM}&token=${DUCK_TOK}&ip=${PUBLIC_IP}" >/dev/null 2>&1 || warn "DuckDNS initial update returned an error"
      if command -v ufw >/dev/null 2>&1 && run_root ufw status 2>/dev/null | grep -qi "Status: active"; then
        run_root ufw allow 80/tcp >/dev/null 2>&1 || true
        run_root ufw allow 443/tcp >/dev/null 2>&1 || true
        run_root ufw allow "${PORT_VALUE}/tcp" >/dev/null 2>&1 || true
      fi
      if command -v firewall-cmd >/dev/null 2>&1 && run_root firewall-cmd --state >/dev/null 2>&1; then
        run_root firewall-cmd --permanent --add-service=http >/dev/null 2>&1 || true
        run_root firewall-cmd --permanent --add-service=https >/dev/null 2>&1 || true
        run_root firewall-cmd --permanent --add-port="${PORT_VALUE}/tcp" >/dev/null 2>&1 || true
        run_root firewall-cmd --reload >/dev/null 2>&1 || true
      fi
      if ! command -v caddy >/dev/null 2>&1; then
        info "Installing Caddy for automatic HTTPS (${DUCK_DOM}.duckdns.org)..."
        if command -v apt-get >/dev/null 2>&1; then
          run_root apt-get update -qq || true
          run_root apt-get install -y -qq debian-keyring debian-archive-keyring apt-transport-https curl gnupg || true
          curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | run_root gpg --dearmor --yes -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg 2>/dev/null || true
          curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | run_root tee /etc/apt/sources.list.d/caddy-stable.list >/dev/null 2>&1 || true
          run_root apt-get update -qq || true
          run_root apt-get install -y -qq caddy || true
        elif command -v dnf >/dev/null 2>&1; then
          run_root dnf install -y 'dnf-command(copr)' caddy || true
        fi
      fi
      if command -v caddy >/dev/null 2>&1; then
        run_root mkdir -p /etc/caddy
        printf "%s.duckdns.org {\n    encode zstd gzip\n    reverse_proxy 127.0.0.1:%s {\n        flush_interval -1\n    }\n}\n" "$DUCK_DOM" "$PORT_VALUE" | run_root tee /etc/caddy/Caddyfile >/dev/null
        run_root systemctl enable --now caddy >/dev/null 2>&1 || true
        run_root systemctl reload caddy >/dev/null 2>&1 || run_root systemctl restart caddy >/dev/null 2>&1 || true
        info "Verifying external HTTPS https://${DUCK_DOM}.duckdns.org/health ..."
        DUCK_HTTPS_OK=0
        for _ in 1 2 3 4 5 6; do
          if curl -fsS --max-time 8 "https://${DUCK_DOM}.duckdns.org/health" >/dev/null 2>&1; then
            DUCK_HTTPS_OK=1
            break
          fi
          sleep 5
        done
        if [ "$DUCK_HTTPS_OK" -eq 1 ]; then
          info "External HTTPS verified: https://${DUCK_DOM}.duckdns.org/health"
        else
          warn "https://${DUCK_DOM}.duckdns.org/health is not reachable externally yet (check cloud provider Security Group / NSG for ports 80 & 443; Cloudflare tunnel remains active as fallback)."
        fi
        "${COMPOSE[@]}" exec -T web python3 -c "import asyncio; from app.utils.duckdns import sync_and_activate_duckdns; print(asyncio.run(sync_and_activate_duckdns()))" >/dev/null 2>&1 || true
      else
        warn "Could not install Caddy automatically; Cloudflare tunnel remains active as fallback."
      fi
    fi

    info "Follow tunnel startup and URL synchronization with: docker compose logs -f web"
    info "Deployment command completed."
    exit 0
  fi
  sleep 2
done
warn "Health check did not pass. Showing service status and recent logs."
"${COMPOSE[@]}" ps || true
"${COMPOSE[@]}" logs --tail=150 web || true
die "Application did not become healthy. Common causes: invalid Telegram credentials, MongoDB Atlas IP allowlist/DNS, incorrect URI/password encoding, or missing bot permissions."

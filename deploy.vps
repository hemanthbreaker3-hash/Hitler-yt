#!/usr/bin/env bash
# Robust HITLER YT VPS deployment. Run from the repository root.
set -Eeuo pipefail
IFS=$'\n\t'

APP_NAME="HITLER YT"
GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'
info(){ printf "${GREEN}[%s]${NC} %s\n" "$APP_NAME" "$*"; }
warn(){ printf "${YELLOW}[WARN]${NC} %s\n" "$*"; }
die(){ printf "${RED}[ERROR]${NC} %s\n" "$*" >&2; exit 1; }
run_root(){ if [ "$(id -u)" -eq 0 ]; then "$@"; elif command -v sudo >/dev/null 2>&1; then sudo "$@"; else die "Root privileges are required. Run as root or install sudo."; fi; }

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"
[[ -f docker-compose.yml && -f Dockerfile && -f requirements.txt ]] || die "Run from the HITLER YT project root; docker-compose.yml, Dockerfile and requirements.txt must exist."
command -v python3 >/dev/null 2>&1 || die "Python 3 is required to validate and write the environment file."

PROJECT_SLUG="$(basename "$SCRIPT_DIR" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_-]+/-/g; s/^-+|-+$//g')"
PROJECT_SLUG="${PROJECT_SLUG:-app}"
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-$PROJECT_SLUG}"

# Host prerequisites.
if ! command -v curl >/dev/null 2>&1; then
  if command -v apt-get >/dev/null 2>&1; then
    run_root apt-get update -qq
    run_root apt-get install -y -qq curl ca-certificates
  elif command -v dnf >/dev/null 2>&1; then
    run_root dnf install -y curl ca-certificates
  else
    die "curl is missing. Install curl and ca-certificates, then rerun."
  fi
fi

if ! command -v docker >/dev/null 2>&1; then
  info "Installing Docker Engine and Compose plugin..."
  curl -fsSL https://get.docker.com -o /tmp/${PROJECT_SLUG}-get-docker.sh || die "Could not download Docker installer. Check VPS DNS/network access."
  run_root sh /tmp/${PROJECT_SLUG}-get-docker.sh
  rm -f /tmp/${PROJECT_SLUG}-get-docker.sh
fi
run_root systemctl enable --now docker || die "Docker service could not be started. Check: sudo systemctl status docker --no-pager"

DOCKER=(docker)
if ! docker info >/dev/null 2>&1; then
  if command -v sudo >/dev/null 2>&1 && sudo docker info >/dev/null 2>&1; then
    DOCKER=(sudo docker)
    warn "Using sudo for Docker because this login session lacks Docker socket permission."
  else
    die "Docker daemon is not accessible. Check 'sudo systemctl status docker' and 'sudo docker info'."
  fi
fi

if "${DOCKER[@]}" compose version >/dev/null 2>&1; then
  COMPOSE=("${DOCKER[@]}" compose)
elif command -v docker-compose >/dev/null 2>&1; then
  if [[ "${DOCKER[0]}" == sudo ]]; then COMPOSE=(sudo docker-compose); else COMPOSE=(docker-compose); fi
else
  warn "Docker Compose plugin missing; attempting package installation..."
  if command -v apt-get >/dev/null 2>&1; then
    run_root apt-get update -qq
    run_root apt-get install -y docker-compose-plugin
  elif command -v dnf >/dev/null 2>&1; then
    run_root dnf install -y docker-compose-plugin
  fi
  if "${DOCKER[@]}" compose version >/dev/null 2>&1; then COMPOSE=("${DOCKER[@]}" compose); else die "Docker Compose is unavailable. Install the Docker Compose plugin and rerun."; fi
fi

# Build .env without prompting for Dynu/DuckDNS credentials (bot-managed in Telegram).
# Supports: export dns=duckdns | export dns=dynu | export dns=dyno | export dns=both | export dns=auto
if [[ ! -f .env ]]; then
  [[ -f .env.example ]] || die ".env.example is missing."
  cp .env.example .env
fi

# Detect current project's own running web port (if any) so re-deploys keep their port,
# while a second deployment on the same VPS automatically picks a free port if 8000 is taken.
OWN_WEB_PORT="$("${DOCKER[@]}" ps --filter "label=com.docker.compose.project=${COMPOSE_PROJECT_NAME}" --filter "label=com.docker.compose.service=web" --format '{{.Ports}}' 2>/dev/null | sed -nE 's/.*:([0-9]+)->.*/\1/p' | head -n 1 || true)"
EXPLICIT_PORT_SET="0"
if [ -n "${PORT:-}" ]; then EXPLICIT_PORT_SET="1"; fi

OWN_WEB_PORT="$OWN_WEB_PORT" EXPLICIT_PORT_SET="$EXPLICIT_PORT_SET" python3 - <<'PY'
import json, os, pathlib, re, secrets, socket

p = pathlib.Path('.env')

def read_env(path):
    if not path.exists(): return {}
    result = {}
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith('#'): continue
        if line.startswith('export '): line = line[7:].lstrip()
        if '=' not in line: continue
        key, value = line.split('=', 1)
        key, value = key.strip(), value.strip()
        if not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', key): continue
        if len(value) >= 2 and value[0] == value[-1] and value[0] in ('"', "'"):
            if value[0] == '"':
                try: value = json.loads(value)
                except Exception: value = value[1:-1]
            else: value = value[1:-1]
        result[key] = value
    return result

def norm_dns(raw):
    v = str(raw or '').strip().lower()
    if v in ('duck', 'duckdns', 'duckdns.org'): return 'duckdns'
    if v in ('dynu', 'dyno', 'dynu.com', 'dynu.net'): return 'dynu'
    if v in ('both', 'all'): return 'both'
    if v in ('none', 'off', 'disabled', 'false', '0'): return 'none'
    return 'auto' if not v else v

def port_in_use(port_num):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.3)
        return s.connect_ex(('127.0.0.1', port_num)) == 0

values = read_env(p)
values.update(read_env(pathlib.Path('config.env')))

aliases = {
    'APP_ID': 'API_ID',
    'DATABASE_URI': 'MONGODB_URI',
    'DATABASE_URL': 'MONGODB_URI',
    'LOG_CHANNEL': 'CHANNEL_ID',
    'dns': 'DNS_PROVIDER',
    'DNS': 'DNS_PROVIDER',
}
for alias, canonical in aliases.items():
    if os.environ.get(alias) and not os.environ.get(canonical):
        os.environ[canonical] = os.environ[alias]

keys = (
    'API_ID','API_HASH','BOT_TOKEN','OWNER_ID','ADMINS','CHANNEL_ID','FORCE_SUB_CHANNELS',
    'MONGODB_URI','DATABASE_NAME','REDIS_URL','BASE_URL','BACKEND_URL','WEBSITE_URL','PORT',
    'DEBUG','DEFAULT_EXPIRY','SESSIONS','ADMIN_PANEL_TOKEN','TMDB_API_KEY','BRANDING',
    'LOGO_URL','STREAM_CHUNK_SIZE','NGROK_AUTHTOKEN','TUNNEL_PROVIDER','CLOUDFLARE_URL',
    'NGROK_URL','DUCKDNS_DOMAIN','DUCKDNS_TOKEN','DNS_PROVIDER'
)
for key in keys:
    if key in os.environ:
        values[key] = os.environ[key]
for alias, canonical in aliases.items():
    if values.get(alias) and not values.get(canonical):
        values[canonical] = values[alias]

values['DNS_PROVIDER'] = norm_dns(values.get('DNS_PROVIDER', 'auto'))

# Auto-pick a free port if PORT was not explicitly exported and desired port is occupied by another deployment
own_port = os.environ.get('OWN_WEB_PORT', '').strip()
explicit_port = os.environ.get('EXPLICIT_PORT_SET', '0') == '1'
try:
    desired_port = int(str(values.get('PORT') or '8000').strip())
except ValueError:
    desired_port = 8000

if not explicit_port and str(desired_port) != own_port and port_in_use(desired_port):
    candidate = desired_port + 1
    while candidate < 8100 and port_in_use(candidate) and str(candidate) != own_port:
        candidate += 1
    print(f"[INFO] Port {desired_port} is already in use by another service; assigning PORT={candidate} for this deployment.")
    desired_port = candidate
values['PORT'] = str(desired_port)

if not values.get('ADMIN_PANEL_TOKEN') or values['ADMIN_PANEL_TOKEN'].lower().startswith(('replace-', 'change_me', 'your_')):
    values['ADMIN_PANEL_TOKEN'] = secrets.token_urlsafe(36)

lines = ['# Generated by deploy.vps (HITLER YT); contains secrets. Do not commit or share.']
for key in sorted(values):
    lines.append(f'{key}={json.dumps(str(values[key]))}')
p.write_text('\n'.join(lines) + '\n')
os.chmod(p, 0o600)
PY

# Strict preflight validation
python3 - <<'PY'
import json, pathlib, re, sys
v = {}
for line in pathlib.Path('.env').read_text().splitlines():
    if not line or line.lstrip().startswith('#') or '=' not in line: continue
    k, raw = line.split('=', 1); raw = raw.strip()
    try: value = json.loads(raw) if raw.startswith('"') else raw
    except Exception: value = raw.strip('"')
    v[k.strip()] = str(value)
required = ('API_ID','API_HASH','BOT_TOKEN','OWNER_ID','MONGODB_URI')
for k in required:
    value = v.get(k, '').strip()
    if not value or value.lower().startswith(('your_', 'change_me', 'replace_')):
        sys.exit(f'[ERROR] {k} is missing or still a placeholder. Export it before deployment or edit config.env.')
for k in ('API_ID','OWNER_ID'):
    if not re.fullmatch(r'-?\d+', v[k].strip()): sys.exit(f'[ERROR] {k} must be numeric.')
for k in ('ADMINS','FORCE_SUB_CHANNELS'):
    raw = v.get(k, '').strip()
    if raw and not all(re.fullmatch(r'-?\d+', x.strip()) for x in raw.split(',')):
        sys.exit(f'[ERROR] {k} must be comma-separated numeric Telegram IDs.')
if v.get('CHANNEL_ID','').strip() and not re.fullmatch(r'-?\d+', v['CHANNEL_ID'].strip()):
    sys.exit('[ERROR] CHANNEL_ID must be numeric.')
if not v['MONGODB_URI'].startswith(('mongodb://','mongodb+srv://')) or v['MONGODB_URI'] == 'mongodb://mongodb:27017':
    sys.exit('[ERROR] Set a reachable MONGODB_URI (for example your MongoDB Atlas URI).')
if len(v.get('ADMIN_PANEL_TOKEN','').strip()) < 24:
    sys.exit('[ERROR] ADMIN_PANEL_TOKEN must contain at least 24 characters.')
PY

info "Validating Docker Compose configuration (project=${COMPOSE_PROJECT_NAME})..."
"${COMPOSE[@]}" config --quiet || die "Compose configuration is invalid. Check .env and docker-compose.yml."
info "Building and starting HITLER YT..."
"${COMPOSE[@]}" up -d --build --remove-orphans

eval "$(python3 - <<'PY'
import json, pathlib, shlex
v={}
for line in pathlib.Path('.env').read_text().splitlines():
    if not line or line.lstrip().startswith('#') or '=' not in line: continue
    k, raw = line.split('=', 1); raw = raw.strip()
    try: val = json.loads(raw) if raw.startswith('"') else raw
    except Exception: val = raw.strip('"')
    v[k.strip()] = str(val)
print(f"PORT_VALUE={shlex.quote(v.get('PORT') or '8000')}")
print(f"DNS_MODE={shlex.quote((v.get('DNS_PROVIDER') or 'auto').strip().lower())}")
print(f"PROVIDER={shlex.quote((v.get('TUNNEL_PROVIDER') or 'cloudflare').strip().lower())}")
PY
)"
PORT_VALUE="${PORT_VALUE:-8000}"
DNS_MODE="${DNS_MODE:-auto}"
PROVIDER="${PROVIDER:-cloudflare}"

info "Waiting up to 180 seconds for http://127.0.0.1:${PORT_VALUE}/health ..."
for _ in $(seq 1 90); do
  if curl -fsS "http://127.0.0.1:${PORT_VALUE}/health" >/dev/null 2>&1; then
    info "Web health check passed on port ${PORT_VALUE} (DNS_PROVIDER=${DNS_MODE})."
    info "Admin dashboard: /panel (username: admin; password stored in .env as ADMIN_PANEL_TOKEN)."
    "${COMPOSE[@]}" ps

    info "TUNNEL_PROVIDER=${PROVIDER}"
    # Open HTTP/HTTPS/App ports in host firewall if active
    if command -v ufw >/dev/null 2>&1 && run_root ufw status 2>/dev/null | grep -qi "Status: active"; then
      run_root ufw allow 80/tcp >/dev/null 2>&1 || true
      run_root ufw allow 443/tcp >/dev/null 2>&1 || true
      run_root ufw allow "${PORT_VALUE}/tcp" >/dev/null 2>&1 || true
    fi
    if command -v firewall-cmd >/dev/null 2>&1 && run_root firewall-cmd --state >/dev/null 2>&1; then
      run_root firewall-cmd --permanent --add-service=http >/dev/null 2>&1 || true
      run_root firewall-cmd --permanent --add-service=https >/dev/null 2>&1 || true
      run_root firewall-cmd --permanent --add-port="${PORT_VALUE}/tcp" >/dev/null 2>&1 || true
      run_root firewall-cmd --reload >/dev/null 2>&1 || true
    fi

    # Resolve active DuckDNS / Dynu hostnames according to DNS_MODE (duckdns | dynu | both | auto | none)
    DUCK_DOM=""; DUCK_TOK=""; DYNU_HOST=""
    if [ "$DNS_MODE" = "duckdns" ] || [ "$DNS_MODE" = "both" ] || [ "$DNS_MODE" = "auto" ]; then
      DUCK_INFO="$(python3 - <<'PY_DUCK'
import json, pathlib
from urllib.parse import urlparse
v={}
for line in pathlib.Path('.env').read_text().splitlines():
    if not line or line.lstrip().startswith('#') or '=' not in line: continue
    k, raw = line.split('=',1); raw=raw.strip()
    try: val=json.loads(raw) if raw.startswith('"') else raw
    except Exception: val=raw.strip('"')
    v[k.strip()]=str(val)
dom = (v.get('DUCKDNS_DOMAIN') or '').strip().lower()
if dom.startswith(('http://','https://')): dom = (urlparse(dom).hostname or '').lower()
dom = dom.strip('.')
if dom.endswith('.duckdns.org'): dom = dom[:-len('.duckdns.org')]
tok = (v.get('DUCKDNS_TOKEN') or '').strip()
print(f"{dom}|{tok}")
PY_DUCK
)"
      DUCK_DOM="${DUCK_INFO%%|*}"
      DUCK_TOK="${DUCK_INFO#*|}"
      if [ -z "$DUCK_DOM" ] || [ -z "$DUCK_TOK" ]; then
        MONGO_DUCK="$("${COMPOSE[@]}" exec -T web python3 -c "import asyncio; from app.utils.duckdns import get_duckdns_config; d,t=asyncio.run(get_duckdns_config()); print(f'{d}|{t}')" 2>/dev/null | tail -n 1 || true)"
        if [[ "$MONGO_DUCK" == *"|"* ]]; then
          DUCK_DOM="${MONGO_DUCK%%|*}"
          DUCK_TOK="${MONGO_DUCK#*|}"
        fi
      fi
    fi

    if [ "$DNS_MODE" = "dynu" ] || [ "$DNS_MODE" = "both" ] || [ "$DNS_MODE" = "auto" ]; then
      DYNU_HOST="$("${COMPOSE[@]}" exec -T web python3 -c "import asyncio; from app.utils.dynu import get_full_config; c=asyncio.run(get_full_config()); print(c.get('hostname',''))" 2>/dev/null | tail -n 1 || true)"
      DYNU_HOST="$(printf '%s' "$DYNU_HOST" | tr -d '\r\n ')"
    fi

    if [ -n "$DUCK_DOM" ] && [ -n "$DUCK_TOK" ]; then
      PUBLIC_IP="$(curl -fsS --max-time 6 https://api.ipify.org 2>/dev/null || curl -fsS --max-time 6 https://ifconfig.me/ip 2>/dev/null || true)"
      curl -fsS --max-time 10 "https://www.duckdns.org/update?domains=${DUCK_DOM}&token=${DUCK_TOK}&ip=${PUBLIC_IP}" >/dev/null 2>&1 || warn "DuckDNS initial update returned an error"
    fi

    # Conflict-free multi-deployment Caddy setup:
    # Each deployment manages ONLY /etc/caddy/conf.d/${PROJECT_SLUG}.caddy
    if { [ -n "$DUCK_DOM" ] && [ -n "$DUCK_TOK" ]; } || [ -n "$DYNU_HOST" ]; then
      if ! command -v caddy >/dev/null 2>&1; then
        info "Installing Caddy for automatic HTTPS reverse proxy..."
        if command -v apt-get >/dev/null 2>&1; then
          run_root apt-get update -qq || true
          run_root apt-get install -y -qq debian-keyring debian-archive-keyring apt-transport-https curl gnupg || true
          curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | run_root gpg --dearmor --yes -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg 2>/dev/null || true
          curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | run_root tee /etc/apt/sources.list.d/caddy-stable.list >/dev/null 2>&1 || true
          run_root apt-get update -qq || true
          run_root apt-get install -y -qq caddy || true
        elif command -v dnf >/dev/null 2>&1; then
          run_root dnf install -y 'dnf-command(copr)' caddy || true
        fi
      fi
      if command -v caddy >/dev/null 2>&1; then
        run_root mkdir -p /etc/caddy/conf.d
        if [ ! -f /etc/caddy/Caddyfile ] || ! grep -q 'conf\.d/\*\.caddy' /etc/caddy/Caddyfile 2>/dev/null; then
          printf "import /etc/caddy/conf.d/*.caddy\n" | run_root tee /etc/caddy/Caddyfile >/dev/null
        fi
        SITE_CONF=""
        if [ -n "$DUCK_DOM" ] && [ -n "$DUCK_TOK" ]; then
          info "Configuring Caddy (/etc/caddy/conf.d/${PROJECT_SLUG}.caddy): ${DUCK_DOM}.duckdns.org -> 127.0.0.1:${PORT_VALUE}"
          SITE_CONF+="${DUCK_DOM}.duckdns.org {\n    encode zstd gzip\n    reverse_proxy 127.0.0.1:${PORT_VALUE} {\n        flush_interval -1\n    }\n}\n\n"
        fi
        if [ -n "$DYNU_HOST" ]; then
          info "Configuring Caddy (/etc/caddy/conf.d/${PROJECT_SLUG}.caddy): ${DYNU_HOST} -> 127.0.0.1:${PORT_VALUE}"
          SITE_CONF+="${DYNU_HOST} {\n    encode zstd gzip\n    reverse_proxy 127.0.0.1:${PORT_VALUE} {\n        flush_interval -1\n    }\n}\n\n"
        fi
        printf "%b" "$SITE_CONF" | run_root tee "/etc/caddy/conf.d/${PROJECT_SLUG}.caddy" >/dev/null
        run_root systemctl enable --now caddy >/dev/null 2>&1 || true
        run_root systemctl reload caddy >/dev/null 2>&1 || run_root systemctl restart caddy >/dev/null 2>&1 || true

        if [ -n "$DUCK_DOM" ] && [ -n "$DUCK_TOK" ]; then
          info "Verifying external HTTPS https://${DUCK_DOM}.duckdns.org/health ..."
          DUCK_HTTPS_OK=0
          for _ in 1 2 3 4 5 6; do
            if curl -fsS --max-time 8 "https://${DUCK_DOM}.duckdns.org/health" >/dev/null 2>&1; then
              DUCK_HTTPS_OK=1; break
            fi
            sleep 5
          done
          if [ "$DUCK_HTTPS_OK" -eq 1 ]; then
            info "External HTTPS verified: https://${DUCK_DOM}.duckdns.org/health"
          else
            warn "https://${DUCK_DOM}.duckdns.org/health is not reachable externally yet (check cloud Security Group / NSG for ports 80 & 443)."
          fi
          "${COMPOSE[@]}" exec -T web python3 -c "import asyncio; from app.utils.duckdns import sync_and_activate_duckdns; print(asyncio.run(sync_and_activate_duckdns()))" >/dev/null 2>&1 || true
        fi

        if [ -n "$DYNU_HOST" ]; then
          info "Verifying external HTTPS https://${DYNU_HOST}/health ..."
          DYNU_HTTPS_OK=0
          for _ in 1 2 3 4 5 6; do
            if curl -fsS --max-time 8 "https://${DYNU_HOST}/health" >/dev/null 2>&1; then
              DYNU_HTTPS_OK=1; break
            fi
            sleep 5
          done
          if [ "$DYNU_HTTPS_OK" -eq 1 ]; then
            info "External HTTPS verified: https://${DYNU_HOST}/health"
          else
            warn "https://${DYNU_HOST}/health is not reachable externally yet (check cloud Security Group / NSG for ports 80 & 443)."
          fi
          "${COMPOSE[@]}" exec -T web python3 -c "import asyncio; from app.utils.dynu import sync_activate; print(asyncio.run(sync_activate()))" >/dev/null 2>&1 || true
        fi
      else
        warn "Could not install Caddy automatically; Cloudflare tunnel remains active as fallback."
      fi
    elif [ -f "/etc/caddy/conf.d/${PROJECT_SLUG}.caddy" ]; then
      run_root rm -f "/etc/caddy/conf.d/${PROJECT_SLUG}.caddy"
      run_root systemctl reload caddy >/dev/null 2>&1 || true
    fi

    info "Follow tunnel startup and URL synchronization with: docker compose logs -f web"
    info "Deployment command completed."
    exit 0
  fi
  sleep 2
done
warn "Health check did not pass. Showing service status and recent logs."
"${COMPOSE[@]}" ps || true
"${COMPOSE[@]}" logs --tail=150 web || true
die "Application did not become healthy. Common causes: invalid Telegram credentials, MongoDB Atlas IP allowlist/DNS, incorrect URI/password encoding, or missing bot permissions."

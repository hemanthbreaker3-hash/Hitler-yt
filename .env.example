# AniMoviesZoneflix configuration. Copy to .env or export variables before deploy.vps.
API_ID=YOUR_API_ID
API_HASH=YOUR_API_HASH
BOT_TOKEN=YOUR_BOT_TOKEN
OWNER_ID=YOUR_TELEGRAM_USER_ID

# Telegram numeric IDs (comma-separated where multiple values are supported)
ADMINS=
CHANNEL_ID=
FORCE_SUB_CHANNELS=
UPDATE_CHANNEL_URL=https://t.me/HiTLERYT

# Use the bundled MongoDB by default, or provide your external MongoDB Atlas URI.
MONGODB_URI=
DATABASE_NAME=tg_media_bot
REDIS_URL=redis://redis:6379/0

# Primary public website URL used in Telegram links (usually your Vercel site).
BASE_URL=https://your-site.vercel.app
# VPS media backend URL. Auto-set from the active tunnel (Cloudflare or ngrok).
BACKEND_URL=
NGROK_URL=
CLOUDFLARE_URL=
# Optional Vercel website URL; Vercel also registers its own domains automatically.
WEBSITE_URL=

# ── Public tunnel provider (VPS stream / download / watch links) ─────────────
# export TUNNEL_PROVIDER=cloudflare   → generate https://*.trycloudflare.com and sync
# export TUNNEL_PROVIDER=ngrok         → use NGROK_AUTHTOKEN (pyngrok)
# export TUNNEL_PROVIDER=auto          → prefer cloudflared if installed, else ngrok
#
# Cloudflare quick tunnels need no account token and avoid free-ngrok bandwidth caps.
TUNNEL_PROVIDER=cloudflare

# ngrok dashboard auth token (only required when TUNNEL_PROVIDER=ngrok)
NGROK_AUTHTOKEN=

# Runtime
PORT=8000
DEBUG=False
# Comma-separated Telethon StringSessions for multi-connection high-speed download/stream
# export SESSIONS=session1,session2,session3,session4
SESSIONS=
ADMIN_PANEL_TOKEN=replace-with-a-long-random-secret
TMDB_API_KEY=
OMDB_API_KEY=
# 4 MiB response chunks (maximum supported). Tune to VPS RAM/network.
STREAM_CHUNK_SIZE=4194304

# Optional DuckDNS dynamic DNS auto-updater (subdomain without .duckdns.org + token)
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# Dynamic DNS provider: duck (DuckDNS) | dynu (Dynu.com) | auto
DNS_PROVIDER=auto
DYNU_DOMAIN=
DYNU_PASSWORD=
DYNU_USERNAME=
